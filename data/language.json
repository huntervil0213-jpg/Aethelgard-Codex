    "phrases":[{"id":"PHR-001","high_elven":"Druveth, ir dhalveth.","common":"Lower your weapons, guards.","register":"military"},{"id":"PHR-002","high_elven":"Oq qirath vaelor?","common":"Who has lawful authority at the border?","register":"military"},{"id":"PHR-003","high_elven":"Zhai qelvashi nu mhaqor.","common":"There is no peace between houses.","register":"hostile"},{"id":"PHR-004","high_elven":"Qhalzun, vhaezun.","common":"By the canopy's witness, contamination.","register":"ritual/hostile"},{"id":"PHR-005","high_elven":"Tzhoraq, zhaevun.","common":"By the first root, ancestral house.","register":"oath"},{"id":"PHR-006","high_elven":"Kaeruq, naevor.","common":"Follow, envoy.","register":"diplomatic"},{"id":"PHR-007","high_elven":"Qevath. Vyrqen.","common":"Stop. Withdraw without surrender.","register":"military"},{"id":"PHR-008","high_elven":"Zhai qhaelis.","common":"The living current is not stable.","register":"scholarly"},{"id":"PHR-009","high_elven":"Mraevul nu mhaqor.","common":"Curse upon your house.","register":"curse"},{"id":"PHR-010","high_elven":"Qhurai.","common":"May the canopy reject you.","register":"curse"},{"id":"PHR-011","high_elven":"Sei quravel.","common":"Your Majesty / Queen.","register":"court"},{"id":"PHR-012","high_elven":"Vesh qhaelis.","common":"The magical current is flowing.","register":"scholarly"},{"id":"PHR-013","high_elven":"Thul qelrai.","common":"It will stabilize.","register":"scholarly"},{"id":"PHR-014","high_elven":"Raq zoryn.","common":"The blueprint was completed/recorded.","register":"scholarly"},{"id":"PHR-015","high_elven":"Dhaur, bhaelun.","common":"Trust me, companion.","register":"casual"}],
    "translation_rules":["Prefer exact lexical mappings over approximate synonyms.","Separate multiple senses with distinct sense IDs.","Do not translate register-specific insults as neutral vocabulary.","Titles retain rank information.","Phrase entries take precedence over individual substitution when idiomatic.","If a requested word is absent, return UNKNOWN rather than inventing a translation.","Romanization remains stable once canonized."],
