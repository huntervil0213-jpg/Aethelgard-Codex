    "purpose": "Original constructed language for formal Elven speech in Kael-Vossen, with military, diplomatic, ritual, colloquial, hostile, and scholarly registers.",
    "translator_profile": "B-dictionary: deterministic Common-to-High-Elven and High-Elven-to-Common entries using stable IDs, explicit meanings, approved inflections, and phrase mappings. Designed for custom dictionary workflows; not claimed to be an official D&D Beyond feature.",
    "design_rules": ["Vocabulary must be broad and genuinely varied.","No approved High Elven lexical item may intentionally duplicate an English/Common word.","Avoid recycling the same visible roots and endings across unrelated words.","Romanization is manuscript-facing; Veyrath is the in-world script.","Formal, military, diplomatic, ritual, scholarly, casual, hostile, and curse registers differ.","Lyra learned the language from archival texts and treaties but never spoke it regularly; her fluency is literary, cautious, and rusty.","Native speakers use idiom, clipped commands, status markers, and cultural implications that Lyra may not reproduce naturally.","Unknown words are never silently translated by guesswork.","Every canonized word receives a stable ID and reversible Common meaning."],
    "alphabet": {"status":"development","name":"Veyrath","principle":"A flowing angular script designed for living wood, crystal, metal, cloth, and boundary stones.","romanization":"Latin characters are only a practical manuscript and translator representation until native glyphs are finalized.","note":"Roman letters are not the in-world alphabet.","draft_glyph_inventory":["Asha","Vey","Qor","Dhei","Zhur","Eln","Rai","Kha","Urr","Myr","Tzai","Oth","Fey","Ghal","Nae","Ivr","Syr","Weth","Xai","Lun","Pha","Jor","Cei","Bhra"]},
    "phonology": {"status":"development","vowels":["a","e","i","o","u","ae","ei","ou","ia","oe","ui","au"],"consonants":["v","z","zh","th","dh","q","x","kh","r","l","m","n","s","sh","t","d","k","g","f","h","y","w","c","j","b","p"],"phonotactic_notes":["Roots may be short, medium, or long and need not share visible patterns.","Clusters may occur at morpheme boundaries, especially in military and formal registers.","Voiced and unvoiced pairs may distinguish related grammatical forms.","Court words favor flowing sonorants and open vowels; commands may be clipped; curses may favor hard clusters.","Avoid accidental resemblance to English/Common vocabulary."]},
    "grammar": {"status":"development","default_word_order":"VSO in formal declarations; flexible order in ordinary conversation; predicate-first commands are common.","aspect":"raq = completed; vesh = ongoing; thul = intended/future.","negation":"zhai precedes the finite verb.","question":"oq begins a formal question; casual questions may use final -ae.","possession":"Possessor follows the possessed noun and is linked by nu.","plural":"ir marks a collective plural before a noun; counted plurals may remain unmarked.","rank":"Titles precede names ceremonially and may replace names in military commands.","honorifics":"Address distinguishes sovereign, elder, commander, scholar, kin, and outsider status.","notes":["Formal speech favors evidential precision and titles.","Commands may omit the subject.","Possession does not use English-style apostrophe construction.","Native speakers compress particles casually; Lyra tends to retain textbook forms."]},
    "particles_and_affixes":[{"id":"ELV-G01","form":"raq","meaning":"completed/past aspect","register":"general"},{"id":"ELV-G02","form":"vesh","meaning":"ongoing/present aspect","register":"general"},{"id":"ELV-G03","form":"thul","meaning":"intended/future aspect","register":"general"},{"id":"ELV-G04","form":"zhai","meaning":"not/no/negative","register":"general"},{"id":"ELV-G05","form":"oq","meaning":"formal question marker","register":"court"},{"id":"ELV-G06","form":"nu","meaning":"possessive linker/of","register":"general"},{"id":"ELV-G07","form":"ir","meaning":"collective plural marker","register":"general"},{"id":"ELV-G08","form":"sei","meaning":"respectful second-person marker","register":"court"},{"id":"ELV-G09","form":"dra","meaning":"familiar second-person marker","register":"casual"},{"id":"ELV-G10","form":"qei","meaning":"evidently/by witnessed fact","register":"scholarly"}],
