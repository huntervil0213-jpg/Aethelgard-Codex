    "registers":{"court":"Precise, ceremonial, status-conscious; full titles and explicit legal distinctions.","military":"Short, clipped, imperative; politeness disappears under immediate threat.","diplomatic":"Measured and respectful without warmth; ambiguity can be deliberate.","ritual":"Older vocabulary, metaphor, ancestral references, formulaic particles.","scholarly":"Technical vocabulary, evidential markers, exact distinctions between natural and artificial magic.","casual":"Shortened forms, familiar address, idioms, teasing, dropped particles.","hostile":"Hard clusters, contempt markers, bloodline insults, inherited grievance vocabulary.","curse":"References to roots, blood, canopy, ancestors, and exile."},
    "lyra_profile":{"status":"canon","knowledge":"Learned through archival texts, regional lexicons, and ancient boundary treaties.","spoken_fluency":"Rusty; comprehension exceeds spontaneous speaking ability.","common_errors":["overly formal word choice","delayed verb selection","misremembered regional ending","textbook pronunciation","self-correction","literal idiom translation"],"strengths":["legal terminology","historical vocabulary","formal grammar","treaty language","old honorifics"],"weaknesses":["casual slang","rapid military speech","new idioms","spontaneous emotional speech","regional contractions"]},
    "commander_profile":{"status":"canon","fluency":"native","style":"Military precision layered over courtly authority.","attitude_to_valerius":"Open disgust and inherited historical hatred; he regards the Valerius bloodline as responsible for generations of exploitation.","language_behavior":"Uses High Elven deliberately to establish sovereignty and test Lyra's archival fluency. Common is used only when he chooses to make a command unmistakable."},
    "manuscript_usage":{"principle":"High Elven should appear throughout scenes involving native Elves, especially greetings, commands, insults, emotional reactions, ritual language, military exchanges, and background conversation.","translation_balance":"Do not make every sentence bilingual. Let context and Lyra's imperfect translations carry meaning.","citizens":"Citizens use casual forms, clipped idioms, and emotionally charged vocabulary distinct from court speech.","canon_boundary":"All new language remains development until deliberately used in the manuscript and approved as canon."}
